<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="ir_cron_update_bcb_exchange_rate" model="ir.cron">
        <field name="name">Tipo de Cambio BCB</field>
        <field name="model_id" ref="base.model_res_currency"/>
        <field name="state">code</field>
        <field name="code">model._cron_update_bcb_rates()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
        <field name="nextcall" eval="(datetime.now() + timedelta(days=1)).replace(hour=5, minute=0, second=0).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</odoo>
