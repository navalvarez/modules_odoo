<?xml version="1.0" encoding="utf-8"?>

<odoo>

    <record id="view_stock_return_picking_reverse_cost_form"
            model="ir.ui.view">

        <field name="name">stock.return.picking.reverse.cost.form</field>
        <field name="model">stock.return.picking</field>

        <field name="inherit_id" eval="False"/>
        <field name="mode">primary</field>
        <field name="priority" eval="99"/>

        <field name="arch" type="xml">

            <form string="Revertir recepción">

                <!-- Campos invisibles requeridos por el domain de location_id -->
                <field name="picking_id" invisible="1"/>
                <field name="company_id" invisible="1"/>
                <field name="original_location_id" invisible="1"/>
                <field name="parent_location_id" invisible="1"/>

                <p colspan="2" class="oe_edit_only">
                    Especifique la cantidad a revertir y la ubicación
                    a la que regresarán los productos.
                </p>

                <field name="product_return_moves" nolabel="1">
                    <tree string="Productos"
                          editable="bottom"
                          create="false">

                        <field name="product_id"
                               readonly="1"
                               force_save="1"/>

                        <field name="quantity"/>

                        <field name="quantity_received"
                               string="Recibida"
                               readonly="1"/>

                        <field name="quantity_reverted"
                               string="Ya revertida"
                               readonly="1"/>

                        <field name="quantity_available"
                               string="Disponible"
                               readonly="1"/>

                        <field name="original_unit_cost"
                               string="Costo original"
                               readonly="1"/>

                        <field name="original_total_value"
                               string="Valor original"
                               readonly="1"/>

                        <field name="move_id" invisible="1"/>

                    </tree>
                </field>
              <group>
                    <label for="location_id" class="oe_inline"/>
                    <div>
                        <field name="location_id"
                               class="oe_inline"
                               required="1"
                               options="{'no_create': True, 'no_open': True}"/>
                    </div>
                </group>

                <footer>
                    <button name="create_returns"
                            string="Revertir"
                            type="object"
                            class="btn-primary"/>

                    <button string="Cancelar"
                            class="btn-secondary"
                            special="cancel"/>
                </footer>

            </form>

        </field>

    </record>

</odoo>